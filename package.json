{
  "name": "dsh-session-purger",
  "version": "0.1.2",
  "description": "Permanently delete conversations from the DSH Web sidebar.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "conversation",
    "delete"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Littlehoax/dsh-session-purger.git"
  },
  "homepage": "https://github.com/Littlehoax/dsh-session-purger#readme",
  "bugs": {
    "url": "https://github.com/Littlehoax/dsh-session-purger/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  }
}